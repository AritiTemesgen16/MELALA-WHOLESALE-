# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ==============================================================================
# MELALA NOTIFICATION ARCHITECTURE PROVIDER CREDENTIALS (OPTIONAL)
# If an external service is not configured, the system gracefully uses a
# transparent Development Mock Adapter to log events without crashing.
# ==============================================================================

# 1. EMAIL PROVIDER (SMTP / Resend / SendGrid)
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT="587"
SMTP_USER="my_smtp_user"
SMTP_PASS="my_smtp_password"
RESEND_API_KEY=""
EMAIL_FROM="notifications@melala.et"

# 2. SMS PROVIDER (Ethio Telecom Gateway / Twilio)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER="+1234567890"
ETHIO_TELECOM_SMS_KEY=""

# 3. TELEGRAM INSTANT BOT INTEGRATION
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# 5. CLOUDINARY MEDIA PERSISTENCE
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# 6. DATABASE PERSISTENCE (POSTGRESQL / FILE STORE)
DATABASE_URL=""
